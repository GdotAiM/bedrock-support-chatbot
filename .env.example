# Environment configuration for bedrock-support-chatbot
# Copy this file to .env and fill in values before running.

# AWS credentials (temp STS session from course lab)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...
# AWS_DEFAULT_REGION=us-east-1

# LLM backend: auto | bedrock | mock
LLM_BACKEND=auto

# Override Bedrock model ID (default: amazon.nova-lite-v1:0)
# BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# DynamoDB ticket table (for local testing with real DB)
# BUG_TICKET_TABLE=BugReports-use1

# ============================================================
# Windows SSL certificate path
# Python's default SSL cert bundle is empty on this machine.
# Set this env var before running any AWS/Bedrock commands:
#   export SSL_CERT_FILE="C:/Users/cash/AppData/Roaming/Python/Python314/site-packages/certifi/cacert.pem"
# Or add it to your PowerShell profile for permanence.
# ============================================================
SSL_CERT_FILE="C:/Users/cash/AppData/Roaming/Python/Python314/site-packages/certifi/cacert.pem"
